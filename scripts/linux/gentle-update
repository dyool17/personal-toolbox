#!/usr/bin/env bash
# gentle-update — refresh every local development tool in one command.
#
# Groups, because they track deliberately different things:
#
#   agents     AI coding agents and their runtimes -> latest stable.
#              Claude Code, Codex, OpenCode, Pi runtime, Gentle Shell, herdr.
#   toolchain  Gentleman tools, each on its own channel.
#              gentle-ai is built from the tip of main; engram from its latest
#              official release (never main). The standalone Gentle Shell home
#              is provisioned by its launcher instead of syncing the regular
#              Pi home.
#   plugins    Claude Code marketplaces and installed plugins.
#   packages   Global package managers and standalone binaries.
#              npm globals, pnpm globals, moshi-hook, mise itself.
#   runtimes   Language runtimes managed by mise. NOT part of `all` — see below.
#
# The standalone launcher is updated before its isolated home is provisioned.
# The PATH Pi runtime is updated separately; Gentle Shell does not update Pi itself.
#
# `runtimes` is opt-in on purpose. mise installs each runtime into its own
# directory and npm globals do not carry across Node versions, so bumping Node
# silently orphans every globally installed CLI. Run it when you are ready to
# reinstall those, not as part of a routine refresh.
#
# Safe to run unattended (see systemd/gentle-update.timer):
#
#   - It builds its own environment, so it does not need an interactive,
#     mise-activated shell.
#   - A lock shared with gentle-rollback keeps two runs from overlapping; a
#     second run exits 0 without doing anything.
#   - `gentle-rollback snapshot` runs before the first update. Without a
#     snapshot nothing is updated, unless GENTLE_UPDATE_NO_SNAPSHOT=1.
#   - A component held by gentle-rollback is skipped, so a release that was
#     rolled back is not reinstalled the next day.
#   - After the updates every tool that answered `--version` before must still
#     answer. One that does not is rolled back to the pre-update snapshot and
#     held, and the run is reported as failed. When it cannot be rolled back it
#     is held anyway and reported for what happened.
#
# Usage:
#   gentle-update [all|agents|toolchain|plugins|packages|runtimes]
#   gentle-update --help
#
# Each step is isolated: a failing tool is reported at the end and never stops
# the remaining tools from updating. The exit status is 1 when anything failed.

set -uo pipefail

BIN_DIR="${GENTLE_UPDATE_BIN_DIR:-$HOME/.local/bin}"
# State shared with gentle-rollback: snapshots, holds, and the lock.
STATE="${GENTLE_UPDATE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/gentle-update}"
# Module paths carry the major version and change on every major release:
# when a new major ships, bump /v4 and /v3 here. The suffix is the channel:
# gentle-ai follows `@main`, the tip of the main branch, to pick up fixes
# before they are released; engram follows `@latest`, which resolves to the
# newest tagged release and never to a prerelease or main.
GENTLE_AI_PKG="github.com/gentleman-programming/gentle-ai/v4/cmd/gentle-ai@main"
ENGRAM_PKG="github.com/Gentleman-Programming/engram/v3/cmd/engram@latest"
# The npm package name remains gentle-pi; it installs the gentle-shell command.
GENTLE_SHELL_NPM_PACKAGE="gentle-pi"
PI_NPM_PACKAGE="@earendil-works/pi-coding-agent"
CODEX_NPM_PACKAGE="@openai/codex"
PNPM_GLOBAL_HOME="${PNPM_HOME:-$HOME/.local/share/pnpm}"
PI_HOMES=("${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}" "${GENTLE_SHELL_HOME:-$HOME/.gentle-shell/agent}")
# Tools that must still answer `--version` after the run. Each name is also
# the gentle-rollback component that restores it.
SMOKE_TOOLS=(claude codex opencode pi gentle-shell herdr gentle-ai engram moshi-hook mise)

TARGET="${1:-all}"
FAILED=()
SKIPPED=()
WORKED_BEFORE=()
ROLLBACK=""
SNAPSHOT_ID=""

bold()    { printf '\n\033[1m%s\033[0m\n' "$*"; }
heading() { printf '\n\033[1;35m── %s ──\033[0m\n' "$*"; }
ok()      { printf '\033[32m✓\033[0m %s\n' "$*"; }
warn()    { printf '\033[33m!\033[0m %s\n' "$*" >&2; }

skip() {
  SKIPPED+=("$1")
  warn "$1"
}

# A component is held when gentle-rollback restored it (or the user asked for
# it with `gentle-rollback hold`). Updating it again would undo the rollback.
held() { [ -e "$STATE/holds/$1" ]; }

# Run one update step: step <component> <name> <binary> <command...>.
# Records failures instead of aborting the run, and skips cleanly when the
# component is held or the tool is not installed on this machine.
step() {
  local key="$1"; shift
  local name="$1"; shift
  local binary="$1"; shift

  if held "$key"; then
    skip "$name — held by gentle-rollback (gentle-rollback unhold $key)"
    return 0
  fi

  if ! command -v "$binary" >/dev/null 2>&1; then
    skip "$name — not installed ('$binary' is not on PATH)"
    return 0
  fi

  printf '\n\033[1m%s\033[0m\n' "$name"
  # The lock descriptor is closed for the step: a daemon started by an updater
  # would otherwise inherit it and keep every later run locked out.
  if "$@" 9>&-; then
    ok "$name"
  else
    FAILED+=("$name")
    warn "$name — update failed"
  fi
}

version_of() {
  command -v "$1" >/dev/null 2>&1 || { echo "—"; return; }
  "$1" --version 2>/dev/null | head -1 | tr -d '\r' || echo "unknown"
}

report_versions() {
  local t
  for t in claude codex opencode pi gentle-shell herdr gentle-ai engram mise qmd; do
    printf '  %-12s %s\n' "$t" "$(version_of "$t")"
  done
}

# --- toolchain ---------------------------------------------------------------

# Build a Go binary into BIN_DIR from the module version its package path
# names (a release for `@latest`, the branch tip for `@main`). The previous
# build is not copied aside here: the pre-update snapshot already holds it,
# and `gentle-rollback restore --only <name>` brings it back.
install_go_binary() {
  local name="$1" pkg="$2"

  # A throwaway working directory keeps the build out of any local Go module.
  local workdir
  workdir="$(mktemp -d)" || return 1
  ( cd "$workdir" && GOBIN="$BIN_DIR" GOFLAGS='' go install "$pkg" )
  local status=$?
  rm -rf "$workdir"
  [ $status -eq 0 ] || return $status

  # Remove copies in earlier PATH directories that would shadow BIN_DIR.
  local gobin gopath dir
  gobin="$(go env GOBIN)"
  gopath="$(go env GOPATH)/bin"
  for dir in "$gobin" "$gopath"; do
    if [ -n "$dir" ] && [ "$dir" != "$BIN_DIR" ] && [ -f "$dir/$name" ]; then
      rm -f "$dir/$name"
    fi
  done
}

# gentle-pi can be pinned to a locally built gentle-ai through a registration
# file, and it refuses to fall back silently while that override is declared.
# Rebuilding gentle-ai into BIN_DIR removes the shadowing copy the override may
# still name, so repair a *broken* override here. An override whose binary
# still exists is a deliberate choice and is never redirected.
sync_gentle_ai_dev_override() {
  local config_home="${GENTLE_PI_CONFIG_HOME:-$HOME/.pi/gentle-ai}"
  local file="$config_home/dev-binary.json"
  local target="$BIN_DIR/gentle-ai"

  [ -f "$file" ] || return 0
  [ -x "$target" ] || return 0

  local declared
  declared="$(rg -o '"path"[[:space:]]*:[[:space:]]*"[^"]+"' "$file" 2>/dev/null | rg -o '/[^"]+')"
  [ -n "$declared" ] || return 0
  [ -e "$declared" ] && return 0

  printf '{"schema": "gentle-pi.dev-binary/v1", "path": "%s"}\n' "$target" > "$file"
  ok "repaired gentle-pi dev binary override -> $target"
}

install_gentle_shell() {
  npm install --global "${GENTLE_SHELL_NPM_PACKAGE}@latest" || return 1
  hash -r 2>/dev/null || true
}

# --- agents ------------------------------------------------------------------

# herdr manages the terminal this script usually runs in and refuses to replace
# its own binary from inside one of its sessions. Detect that rather than
# reporting it as a breakage.
update_herdr() {
  if ! command -v herdr >/dev/null 2>&1; then
    skip "herdr — not installed"
    return 0
  fi
  if [ -n "${HERDR_ENV:-}" ] && ! held herdr; then
    skip "herdr — run 'herdr update' from a terminal outside herdr"
    return 0
  fi
  step herdr "herdr" herdr herdr update
}

# --- plugins -----------------------------------------------------------------

update_claude_plugins() {
  claude plugin marketplace update || return 1

  local plugin status=0
  while read -r plugin; do
    [ -n "$plugin" ] || continue
    printf '  updating %s\n' "$plugin"
    claude plugin update "$plugin" || status=1
  done < <(claude plugin list 2>/dev/null | rg -o '[A-Za-z0-9_-]+@[A-Za-z0-9_-]+')

  return $status
}

# --- packages ----------------------------------------------------------------

# npm links bin names in install order, and corepack declares `pnpm` and `pnpx`
# just like pnpm does. After a global update corepack can end up owning those
# names, which silently swaps the installed pnpm for whatever version corepack
# resolves. Give them back to the package that is actually installed.
restore_pnpm_bins() {
  local npm_bin pkg name
  npm_bin="$(dirname "$(command -v npm)")" || return 0
  pkg="$npm_bin/../lib/node_modules/pnpm"
  [ -d "$pkg" ] || return 0

  for name in pnpm pnpx; do
    if [ -e "$pkg/$name" ] && readlink "$npm_bin/$name" 2>/dev/null | rg -q corepack; then
      ln -sf "../lib/node_modules/pnpm/$name" "$npm_bin/$name"
      ok "restored '$name' to the installed pnpm (corepack had claimed it)"
    fi
  done
}

# Same mapping as gentle-rollback: these packages are components of their own,
# every other npm global belongs to `npm-globals`.
npm_component() {
  case "$1" in
    "$PI_NPM_PACKAGE")           echo pi ;;
    "$GENTLE_SHELL_NPM_PACKAGE") echo gentle-shell ;;
    "$CODEX_NPM_PACKAGE")        echo codex ;;
    *)                           echo npm-globals ;;
  esac
}

# A blanket `npm update -g` would also bump packages whose component is held,
# so the packages are named one by one and the held ones are left out.
update_npm_globals() {
  local listing names pkg pkgs=()
  # A listing that does not parse is not an empty listing: fail the step
  # instead of reporting that there was nothing to update. npm's own error
  # output is left on stderr.
  #
  # The exit status alone is not the test: `npm ls` also exits non-zero for an
  # extraneous or unmet-peer package while still printing a complete listing,
  # and that must not fail the step every single day.
  listing="$(npm ls -g --depth=0 --json)" || warn "npm ls -g exited non-zero; using its listing if it parses"
  # jq alone would accept empty output as "no packages", so require an object
  # that is not npm's error report.
  if [ -z "$listing" ] || ! names="$(jq -r 'if type == "object" and (has("error") | not)
      then (.dependencies // {} | keys[])
      else error("not a package listing") end' <<<"$listing" 2>/dev/null)"; then
    warn "npm ls -g printed no usable package list; npm globals were not updated"
    return 1
  fi

  while read -r pkg; do
    [ -n "$pkg" ] || continue
    if held "$(npm_component "$pkg")"; then
      printf '  leaving %s alone (held)\n' "$pkg"
      continue
    fi
    pkgs+=("$pkg")
  done <<<"$names"

  if [ ${#pkgs[@]} -eq 0 ]; then
    printf '  no npm globals to update\n'
    return 0
  fi
  npm update -g "${pkgs[@]}" || return 1
  restore_pnpm_bins
}

# pnpm's global bin directory is not on this machine's PATH, which makes pnpm
# refuse every global command. Supply it for the duration of the call only.
#
# No `--latest`: that ignores the version range a package was installed with
# and jumps major versions, which is not something to do unattended.
update_pnpm_globals() {
  if [ ! -d "$PNPM_GLOBAL_HOME" ]; then
    skip "pnpm globals — no global store at $PNPM_GLOBAL_HOME"
    return 0
  fi
  # Resolve pnpm before touching PATH: the global bin directory holds a stale
  # pnpm shim that would otherwise win the lookup and fail to exec.
  local pnpm_bin
  pnpm_bin="$(command -v pnpm)" || return 1

  PNPM_HOME="$PNPM_GLOBAL_HOME" PATH="$PNPM_GLOBAL_HOME/bin:$PATH" \
    "$pnpm_bin" update -g
}

# Names of the features `moshi-hook doctor --json` reports as ok, one per line.
moshi_ok_features() {
  jq -r '.features[]? | select(.status == "ok") | .id' <<<"$1" 2>/dev/null | sort
}

# Updating the moshi-hook binary is only half of the job: the hooks written
# into each agent belong to the build that wrote them, and the daemon keeps
# running the old binary until it restarts.
#
# doctor is only ever run with --json. With --yes it applies its fixes without
# asking, which would install hooks and change host settings nobody chose.
update_moshi_hook() {
  local bin before_sha after_sha before_doc after_doc ready agent home regressed status=0
  bin="$(command -v moshi-hook)" || return 1
  before_sha="$(sha256sum "$bin" | cut -d' ' -f1)"
  before_doc="$(moshi-hook doctor --json 2>/dev/null </dev/null)"
  # Only agents that already have hooks get them reinstalled; an update must
  # never wire Moshi into an agent the user did not set up.
  ready="$(jq -r '.features[]? | select(.id == "inbox") | .readyAgents[]?' <<<"$before_doc" 2>/dev/null)"

  moshi-hook update || return 1

  while read -r agent; do
    case "$agent" in
      "") ;;
      pi)
        # Pi hooks live inside a Pi home, and there are two of them. doctor
        # reports `pi` as one agent, so check each home for its own hook file.
        for home in "${PI_HOMES[@]}"; do
          [ -f "$home/extensions/moshi-hooks.ts" ] || continue
          PI_CODING_AGENT_DIR="$home" moshi-hook install --target pi || status=1
        done
        ;;
      *)
        moshi-hook install --target "$agent" || status=1
        ;;
    esac
  done <<<"$ready"

  # Restarting drops the live connection to the phone, so only do it when
  # there is a new binary to load.
  after_sha="$(sha256sum "$bin" | cut -d' ' -f1)"
  if [ "$before_sha" != "$after_sha" ]; then
    moshi-hook service restart || status=1
  else
    printf '  moshi-hook binary unchanged; daemon left running\n'
  fi

  after_doc="$(moshi-hook doctor --json 2>/dev/null </dev/null)"
  regressed="$(comm -23 <(moshi_ok_features "$before_doc") <(moshi_ok_features "$after_doc") | paste -sd, -)"
  if [ -n "$regressed" ]; then
    warn "moshi-hook doctor: no longer ok after the update: $regressed"
    status=1
  fi
  return $status
}

# --- runtimes ----------------------------------------------------------------

update_runtimes() {
  warn "mise installs each runtime in its own directory; npm globals do not"
  warn "carry across Node versions. Reinstall your global CLIs afterwards."
  mise upgrade --yes
}

# --- health ------------------------------------------------------------------

# Gentle Shell ships under two sources (npm:gentle-pi and the gentle-shell git
# repo). A Pi home that declares both, or the same package twice, fails to load
# every duplicated tool. Report it; never edit a Pi settings.json silently.
check_pi_homes() {
  command -v jq >/dev/null 2>&1 || return 0
  local home file dupes
  for home in "${PI_HOMES[@]}"; do
    file="$home/settings.json"
    [ -f "$file" ] || continue
    dupes="$(jq -r '
      [.packages[]? | if type == "object" then .source else . end
        | sub("^npm:gentle-pi(@.*)?$"; "gentle-shell")
        | sub("^git:.*/gentle-shell(@.*)?$"; "gentle-shell")
        | sub("^(?<n>npm:@?[^@]+)@.*$"; "\(.n)")]
      | group_by(.) | map(select(length > 1) | .[0]) | join(", ")' "$file" 2>/dev/null)"
    if [ -n "$dupes" ]; then
      FAILED+=("Pi home $home declares duplicate packages: $dupes (edit $file)")
      warn "Pi home $home declares duplicate packages: $dupes"
    fi
  done
}

# `gentle-shell --isolated setup` re-adds an unpinned companion package (for
# example npm:gentle-engram) next to the pinned one it also writes, and Pi then
# fails to load the duplicated tool. Drop the bare entry only when a pinned entry
# for the same package exists in the Gentle Shell home, and say so out loud.
dedupe_gentle_shell_home() {
  command -v jq >/dev/null 2>&1 || return 0
  local file="${PI_HOMES[1]}/settings.json"
  [ -f "$file" ] || return 0

  local before after tmp
  before="$(jq -c '.packages // []' "$file" 2>/dev/null)" || return 0
  tmp="$(mktemp)" || return 0
  jq '.packages as $p
      | .packages = [ $p[]? | select(
          (type != "string") or (test("^npm:[^@]+$") | not)
          or ((. + "@") as $bare | any($p[]?; type == "string" and startswith($bare)) | not)
        ) ]' "$file" > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 0; }
  after="$(jq -c '.packages // []' "$tmp")"

  if [ "$before" != "$after" ]; then
    cat "$tmp" > "$file"
    ok "removed duplicate unpinned package(s) from the Gentle Shell home: $before -> $after"
  fi
  rm -f "$tmp"
}

answers_version() { timeout 20 "$1" --version >/dev/null 2>&1 </dev/null; }

# Hold a component that could not be put back, so the next daily run does not
# reinstall the same broken release (possibly through the broken tool itself).
hold_broken() {
  "$ROLLBACK" hold "$1" "$2" 9>&- >/dev/null \
    || warn "$1 could not be held; the next run will try to update it again"
}

# A tool that answered `--version` before the run and no longer does was broken
# by this run. Put it back from the pre-update snapshot; gentle-rollback holds
# it, so tomorrow's run does not install the same broken release again.
#
# Each outcome is reported for what it is. "Rolled back" is only claimed when
# gentle-rollback restored something (exit 0, not 3 = nothing differed) and
# the tool answers again afterwards.
smoke_check() {
  local tool status
  for tool in "${WORKED_BEFORE[@]}"; do
    answers_version "$tool" && continue
    warn "$tool no longer runs after the update"

    if [ -z "$SNAPSHOT_ID" ]; then
      FAILED+=("$tool broke after the update; not rolled back (no snapshot)")
      continue
    fi

    # The snapshot is named by id: after the first restore `latest` would be
    # that restore's own pre-rollback snapshot, which holds the broken state.
    "$ROLLBACK" restore "$SNAPSHOT_ID" --only "$tool" --yes 9>&-
    status=$?
    hash -r 2>/dev/null || true

    if [ "$status" -eq 3 ]; then
      hold_broken "$tool" "stopped working after an update; recorded state unchanged"
      FAILED+=("$tool stopped working but its recorded state is unchanged; held, needs manual attention")
    elif [ "$status" -eq 0 ] && answers_version "$tool"; then
      FAILED+=("$tool broke after the update; rolled back and held")
    else
      # Includes mise, claude and opencode, whose restore runs the broken tool.
      hold_broken "$tool" "broke after an update; rollback to $SNAPSHOT_ID failed"
      FAILED+=("$tool broke after the update; rollback failed")
    fi
  done
}

# --- main --------------------------------------------------------------------

case "$TARGET" in
  all|agents|toolchain|plugins|packages|runtimes) ;;
  -h|--help)
    # The header comment is the manual; print it without the comment markers.
    sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  *)
    printf 'usage: gentle-update [all|agents|toolchain|plugins|packages|runtimes]\n' >&2
    exit 2
    ;;
esac

# Everything this installs belongs to the user. As root it would leave
# root-owned files in the user's tool directories and update root's own copies.
if [ "${EUID:-$(id -u)}" -eq 0 ]; then
  printf 'gentle-update: refusing to run as root; run it as your own user\n' >&2
  exit 1
fi

# Without these the lock, the snapshot, or a step would fail in a way that
# reads as "busy" or "nothing to do", so check them before doing anything.
for tool in jq flock sha256sum timeout rg; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    printf 'gentle-update: missing required tool: %s; nothing was updated\n' "$tool" >&2
    exit 1
  fi
done

wants() { [ "$TARGET" = all ] || [ "$TARGET" = "$1" ]; }

mkdir -p "$BIN_DIR"

# Under systemd (or any shell that mise did not activate) node, npm, pnpm, go
# and every npm-installed CLI are missing from PATH. Ask mise for the
# environment an interactive shell would have. It is resolved from $HOME so a
# project-local mise config never decides which runtimes get updated.
if [ -z "${MISE_SHELL:-}" ]; then
  MISE_BIN="$BIN_DIR/mise"
  [ -x "$MISE_BIN" ] || MISE_BIN="$(command -v mise 2>/dev/null || true)"
  if [ -n "$MISE_BIN" ]; then
    cd "$HOME" || exit 1
    # mise's own error output is left on stderr. A failure here must stop the
    # run: carrying on would skip every step as "not installed" and still
    # report success.
    if ! MISE_ENV="$("$MISE_BIN" env -s bash)" || [ -z "$MISE_ENV" ]; then
      printf 'gentle-update: "%s env -s bash" failed or printed no environment; nothing was updated\n' "$MISE_BIN" >&2
      exit 1
    fi
    eval "$MISE_ENV"
  fi
fi
# Locally installed tools win over the copies mise may also provide.
if [ -d "$HOME/.opencode/bin" ]; then PATH="$HOME/.opencode/bin:$PATH"; fi
PATH="$BIN_DIR:$PATH"
export PATH

# Run every step from $HOME, so a project-local .pi directory or package
# manifest in the directory this was started from never takes part.
cd "$HOME" || exit 1

# One lock for gentle-update and gentle-rollback, held on descriptor 9 until
# this process exits. A run that finds it taken has nothing to do: the other
# run is already updating (or restoring) the same tools.
mkdir -p "$STATE" && chmod 700 "$STATE" || exit 1
exec 9>"$STATE/lock" || exit 1
if ! flock -n 9; then
  printf 'gentle-update: another update or rollback is already running; nothing to do.\n'
  exit 0
fi
# Tells the gentle-rollback calls below not to take the lock again.
export GENTLE_UPDATE_LOCK_HELD=1

# gentle-rollback normally sits next to this script; $0 may be a symlink.
ROLLBACK="$(dirname "$(readlink -f "$0")")/gentle-rollback"
[ -x "$ROLLBACK" ] || ROLLBACK="$(command -v gentle-rollback 2>/dev/null || true)"

for tool in "${SMOKE_TOOLS[@]}"; do
  if answers_version "$tool"; then WORKED_BEFORE+=("$tool"); fi
done

bold "Before"
report_versions

# No update without a way back. The snapshot is what `gentle-rollback restore`
# and the smoke check at the end restore from.
if [ "${GENTLE_UPDATE_NO_SNAPSHOT:-}" = 1 ]; then
  warn "GENTLE_UPDATE_NO_SNAPSHOT=1 — updating without a snapshot; this run cannot be rolled back"
elif [ -z "$ROLLBACK" ]; then
  warn "gentle-rollback not found next to this script or on PATH; nothing was updated"
  warn "(set GENTLE_UPDATE_NO_SNAPSHOT=1 to update without a snapshot)"
  exit 1
elif SNAPSHOT_ID="$("$ROLLBACK" snapshot --reason "pre-update ($TARGET)" 9>&-)" && [ -n "$SNAPSHOT_ID" ]; then
  ok "snapshot $SNAPSHOT_ID (undo with: gentle-rollback restore $SNAPSHOT_ID)"
else
  warn "the pre-update snapshot failed; nothing was updated"
  warn "(set GENTLE_UPDATE_NO_SNAPSHOT=1 to update without a snapshot)"
  exit 1
fi

if wants agents || wants toolchain || wants packages; then
  heading "Gentle Shell standalone launcher"
  step gentle-shell "Gentle Shell launcher (npm:${GENTLE_SHELL_NPM_PACKAGE})" npm install_gentle_shell
fi

if wants agents || wants toolchain; then
  heading "Gentle Shell isolated home"
  if wants agents; then
    # --all also refreshes the packages the plain `pi` home declares, so it
    # never lags behind the isolated Gentle Shell home.
    step pi "PATH Pi runtime + extensions" pi pi update --all
    # --all does not touch the model catalogs; those have their own flag.
    step pi "Pi model catalog" pi pi update --models
  fi
  step gentle-shell "Gentle Shell setup" gentle-shell gentle-shell --isolated setup
fi

if wants agents; then
  heading "AI agents (latest stable)"
  step claude   "Claude Code" claude   claude update
  step codex    "Codex"       codex    codex update
  step opencode "OpenCode"    opencode opencode upgrade
  step gentle-shell "Gentle Shell extensions"    gentle-shell gentle-shell --isolated update --extensions
  step gentle-shell "Gentle Shell model catalog" gentle-shell gentle-shell --isolated update --models
  update_herdr
fi

if wants toolchain; then
  heading "Gentleman toolchain (gentle-ai: main, engram: latest release)"
  step gentle-ai "gentle-ai" go install_go_binary gentle-ai "$GENTLE_AI_PKG"
  step engram    "engram"    go install_go_binary engram    "$ENGRAM_PKG"
  sync_gentle_ai_dev_override
fi

if wants plugins; then
  heading "Claude Code plugins"
  step claude-plugins "Claude Code plugins" claude update_claude_plugins
fi

if wants packages; then
  heading "Global packages"
  step npm-globals  "npm globals"  npm        update_npm_globals
  step pnpm-globals "pnpm globals" pnpm       update_pnpm_globals
  step moshi-hook   "moshi-hook"   moshi-hook update_moshi_hook
  step mise         "mise"         mise       mise self-update --yes
fi

