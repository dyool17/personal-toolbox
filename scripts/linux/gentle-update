#!/usr/bin/env bash
# gentle-update — refresh every local development tool in one command.
#
# Groups, because they track deliberately different things:
#
#   agents     AI coding agents and their runtimes -> latest stable.
#              Claude Code, Codex, Pi runtime, Gentle Shell, herdr.
#   toolchain  Gentleman tools -> latest official release (never main).
#              Standalone gentle-ai is pinned to stable v5.0.0 and synced
#              only from a validated build. Engram tracks its release channel.
#   plugins    Claude Code marketplaces and installed plugins.
#   packages   Global package managers and standalone binaries.
#              npm globals, pnpm globals, moshi-hook, mise itself. The
#              moshi-hook step refreshes hooks for Claude Code, Codex, and
#              standalone Pi. Only all can refresh the isolated Shell hooks,
#              as part of work on that Shell home.
#   runtimes   Language runtimes managed by mise. NOT part of `all` — see below.
#
# Gentle Shell uses its native release upgrade only from a verified bundled
# launcher when the official latest is v5. Native upgrade resolves latest again;
# it has no exact-tag pin. Otherwise choose an exact v5 tag at:
# https://github.com/Gentleman-Programming/gentle-shell/releases
# Follow that release's installer or your package owner's instructions.
# Only agents, toolchain, and all upgrade Shell. Setup and extension refresh
# run on the verified target and retry there if they did not finish.
# Separately managed PATH Pi is updated independently of the bundled Pi.
#
# `runtimes` is opt-in on purpose. mise installs each runtime into its own
# directory and npm globals do not carry across Node versions, so bumping Node
# silently orphans every globally installed CLI. Run it when you are ready to
# reinstall those, not as part of a routine refresh.
#
# Safe to run unattended (see systemd/gentle-update.timer):
#
#   - It builds its own environment, so it does not need an interactive,
#     mise-activated shell.
#   - A lock shared with gentle-rollback keeps two runs from overlapping; a
#     second run exits 0 without doing anything.
#   - `gentle-rollback snapshot` runs before the first update. Without a
#     snapshot nothing is updated, unless GENTLE_UPDATE_NO_SNAPSHOT=1.
#   - A component held by gentle-rollback is skipped, so a release that was
#     rolled back is not reinstalled the next day.
#   - After the updates every tool that answered `--version` before must still
#     answer. Failures use snapshot rollback where supported. For bundled Shell
#     recovery, use its own `gentle-shell upgrade --rollback` if available, or
#     its installer; gentle-rollback cannot restore the managed prefix.
#
# Every run writes a log to ~/.local/state/gentle-update/logs (the newest 30
# are kept; `latest.log` points at the last one). It holds the full output plus
# the command, exit status and duration of each step, and its path is printed
# when a run fails. GENTLE_UPDATE_NO_LOG=1 turns it off; GENTLE_UPDATE_TRACE=1
# adds a `set -x` trace next to it.
#
# npm scripts: global installs use a command-local --allow-scripts whitelist.
# Pi/Gentle Shell installs are PROJECT scoped (npm --prefix <home>/npm):
# their whitelist belongs in the project package.json#allowScripts
# (which overrides .npmrc), NOT in npm_config_* environment.
# Existing explicit denials are preserved; no global npmrc changes.
#
# Usage:
#   gentle-update [all|agents|toolchain|plugins|packages|runtimes]
#   gentle-update --help
#
# Each step is isolated: a failing tool is reported at the end and never stops
# the remaining tools from updating. The exit status is 1 when anything failed.

set -uo pipefail

BIN_DIR="${GENTLE_UPDATE_BIN_DIR:-$HOME/.local/bin}"
# State shared with gentle-rollback: snapshots, holds, and the lock.
STATE="${GENTLE_UPDATE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/gentle-update}"
GENTLE_AI_MODULE="github.com/gentleman-programming/gentle-ai"
GENTLE_AI_VERSION=v5.0.0
GENTLE_AI_PKG="$GENTLE_AI_MODULE/v5/cmd/gentle-ai@$GENTLE_AI_VERSION"
ENGRAM_PKG="github.com/Gentleman-Programming/engram/v3/cmd/engram@latest"
GENTLE_SHELL_NPM_PACKAGE="gentle-pi"
SHELL_PREFIX="$HOME/.gentle-shell"
SHELL_LAUNCHER="$SHELL_PREFIX/bin/gentle-shell"
SHELL_MANUAL='choose an exact v5 release at https://github.com/Gentleman-Programming/gentle-shell/releases and follow its installer or instructions from your package owner'
STABLE_VERSION='(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)'
SHELL_HOME_PENDING="$STATE/gentle-shell-home.pending"
SHELL_HOME_VERSION=''
SHELL_HOME_READY=0
AI_READY=0
# Intentionally narrow: inspect dependency scripts before adding more names.
NPM_SCRIPT_ALLOWLIST="gentle-pi,@google/genai,protobufjs"
PI_NPM_PACKAGE="@earendil-works/pi-coding-agent"
CODEX_NPM_PACKAGE="@openai/codex"
PNPM_GLOBAL_HOME="${PNPM_HOME:-$HOME/.local/share/pnpm}"
PI_HOMES=("${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}" "${GENTLE_SHELL_HOME:-$HOME/.gentle-shell/agent}")
# Agents whose Moshi hooks every update installs, named as moshi-hook targets.
MOSHI_AGENTS=(claude codex pi)
# Tools that must still answer `--version` after the run. Each name is also
# the gentle-rollback component that restores it.
SMOKE_TOOLS=(claude codex pi gentle-shell herdr gentle-ai engram moshi-hook mise)

TARGET="${1:-all}"
FAILED=()
SKIPPED=()
WORKED_BEFORE=()
BUNDLED_SHELL_BEFORE=0
ROLLBACK=""
SNAPSHOT_ID=""

bold()    { printf '\n\033[1m%s\033[0m\n' "$*"; }
heading() { printf '\n\033[1;35m── %s ──\033[0m\n' "$*"; }
ok()      { printf '\033[32m✓\033[0m %s\n' "$*"; }
# Warnings go to a file, not an array: warn also runs inside subshells and
# pipelines, whose array changes would be lost before the summary.
WARN_FILE="$(mktemp "${TMPDIR:-/tmp}/gentle-update-warn.XXXXXX" 2>/dev/null || true)"
print_warn() { printf '\033[33m!\033[0m %s\n' "$*" >&2; }
warn() {
  print_warn "$@"
  [ -n "$WARN_FILE" ] && printf '%s\n' "$*" >>"$WARN_FILE"
  return 0
}

# Skips are listed under their own heading, so they are not warnings too.
skip() {
  SKIPPED+=("$1")
  print_warn "$1"
}

# --- run log -----------------------------------------------------------------

# Every run keeps a transcript under LOG_DIR: what the terminal showed (both
# streams, colors removed) plus log-only lines for the environment, the command
# behind each step, its exit status and how long it took.
LOG_DIR="${GENTLE_UPDATE_LOG_DIR:-$STATE/logs}"
LOG_KEEP=30
LOG_FILE=""
LOG_PIDS=()
STARTED=$SECONDS

# Append one line to the run log only; the terminal never sees it.
note() {
  [ -n "$LOG_FILE" ] || return 0
  printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*" >>"$LOG_FILE"
}

# Start the run log: start_log <arguments the script was started with>.
# A log that cannot be written is reported and never stops the run.
start_log() {
  [ "${GENTLE_UPDATE_NO_LOG:-}" = 1 ] && return 0
  local file old invoker=non-interactive script
  file="$LOG_DIR/gentle-update-$(date '+%Y%m%d-%H%M%S')-$$.log"
  if ! { mkdir -p "$LOG_DIR" && : >"$file"; } 2>/dev/null; then
    warn "cannot write a run log under $LOG_DIR; continuing without one"
    return 0
  fi
  LOG_FILE="$file"
  ln -sfn "${file##*/}" "$LOG_DIR/latest.log"
  # Log names sort by start time, so the oldest ones are the ones to drop.
  find "$LOG_DIR" -maxdepth 1 -name 'gentle-update-*.log' | sort -r | tail -n +$((LOG_KEEP + 1)) \
    | while read -r old; do rm -f "$old" "${old%.log}.trace"; done

  # INVOCATION_ID alone does not mean a timer: a terminal started by a systemd
  # user unit hands it down to every shell inside it.
  if [ -t 1 ]; then invoker=terminal; elif [ -n "${INVOCATION_ID:-}" ]; then invoker="non-interactive, under a systemd unit"; fi
  script="$(readlink -f "$0")"
  {
    printf 'gentle-update run log\n'
    printf '  started  %s\n' "$(date '+%Y-%m-%d %H:%M:%S %z')"
    printf '  command  %s\n' "$0 $*"
    printf '  script   %s (sha256 %s)\n' "$script" "$(sha256sum "$script" 2>/dev/null | cut -c1-12)"
    printf '  invoker  %s\n' "$invoker"
    printf '  system   %s, bash %s\n' "$(uname -srm)" "$BASH_VERSION"
    printf '  cwd      %s\n' "$PWD"
    printf '  PATH     %s\n\n' "$PATH"
  } >>"$LOG_FILE"

  # The terminal keeps both streams apart; the log gets a copy of each. tee
  # ignores Ctrl-C so an interrupted run still logs its last lines.
  exec 6>&1 7>&2
  exec 2> >(exec tee -i -a "$LOG_FILE" >&2)
  LOG_PIDS+=("$!")
  exec > >(exec tee -i -a "$LOG_FILE")
  LOG_PIDS+=("$!")
  trap finish_log EXIT
}

# GENTLE_UPDATE_TRACE=1 also writes a `set -x` trace next to the log. It is opt-in
# because a trace records every expanded value, including whatever a command
# line carries.
start_trace() {
  [ -n "$LOG_FILE" ] && [ "${GENTLE_UPDATE_TRACE:-}" = 1 ] || return 0
  exec 8>"${LOG_FILE%.log}.trace" || return 0
  BASH_XTRACEFD=8
  PS4='+ ${EPOCHREALTIME} line ${LINENO} ${FUNCNAME[0]:-main}: '
  set -x
}

# Close the run log on exit, whatever the exit path was.
finish_log() {
  local status=$? pid tries=0
  trap - EXIT
  [ -n "$WARN_FILE" ] && rm -f "$WARN_FILE"
  { set +x; } 2>/dev/null
  # Give the terminal back and let the transcript drain. A daemon started by a
  # step can keep the pipes open, so the wait is bounded.
  exec 1>&6 2>&7 6>&- 7>&-
  for pid in "${LOG_PIDS[@]}"; do
    while kill -0 "$pid" 2>/dev/null && [ "$tries" -lt 20 ]; do
      sleep 0.1
      tries=$((tries + 1))
    done
  done
  note "finished: exit $status after $((SECONDS - STARTED))s"
  sed -i 's/\x1b\[[0-9;]*[A-Za-z]//g' "$LOG_FILE" 2>/dev/null
  if [ "$status" -ne 0 ]; then
    printf 'gentle-update: run log: %s\n' "$LOG_FILE" >&2
  fi
}

# Log-only: the environment the steps run in. A tool resolved from the wrong
# directory is the usual reason an update "worked" and changed nothing.
note_environment() {
  [ -n "$LOG_FILE" ] || return 0
  local t
  note "PATH after environment setup: $PATH"
  note "held components: $(find "$STATE/holds" -mindepth 1 -printf '%f ' 2>/dev/null)"
  for t in "${SMOKE_TOOLS[@]}" node npm pnpm go git jq; do
    note "  $t -> $(command -v "$t" 2>/dev/null || echo 'not on PATH')"
  done
}

# A component is held when gentle-rollback restored it (or the user asked for
# it with `gentle-rollback hold`). Updating it again would undo the rollback.
held() { [ -e "$STATE/holds/$1" ]; }

# Run one update step: step <component> <name> <binary> <command...>.
# Records failures instead of aborting the run, and skips cleanly when the
# component is held or the tool is not installed on this machine.
step() {
  local key="$1"; shift
  local name="$1"; shift
  local binary="$1"; shift

  if held "$key"; then
    skip "$name — held by gentle-rollback (gentle-rollback unhold $key)"
    return 0
  fi

  if ! command -v "$binary" >/dev/null 2>&1; then
    skip "$name — not installed ('$binary' is not on PATH)"
    return 0
  fi

  printf '\n\033[1m%s\033[0m\n' "$name"
  local started=$SECONDS status
  note "step '$name' ($key): $*"
  # The lock descriptor is closed for the step: a daemon started by an updater
  # would otherwise inherit it and keep every later run locked out.
  "$@" 9>&-
  status=$?
  if [ "$status" -eq 0 ]; then
    ok "$name"
  else
    FAILED+=("$name")
    warn "$name — update failed (exit $status)"
  fi
  note "step '$name' finished: exit $status in $((SECONDS - started))s"
}

version_of() {
  command -v "$1" >/dev/null 2>&1 || { echo "—"; return; }
  "$1" --version 2>/dev/null | head -1 | tr -d '\r' || echo "unknown"
}

REPORTED_TOOLS=(claude codex pi gentle-shell herdr gentle-ai engram mise qmd)
declare -A VERSION_BEFORE=()

# The first call records each version; later calls mark what changed since.
report_versions() {
  local t v
  for t in "${REPORTED_TOOLS[@]}"; do
    v="$(version_of "$t")"
    if [ -z "${VERSION_BEFORE[$t]+set}" ]; then
      VERSION_BEFORE[$t]="$v"
      printf '  %-12s %s\n' "$t" "$v"
    elif [ "${VERSION_BEFORE[$t]}" != "$v" ]; then
      printf '  %-12s %s -> %s  (upgraded)\n' "$t" "${VERSION_BEFORE[$t]}" "$v"
    else
      printf '  %-12s %s\n' "$t" "$v"
    fi
  done
}

# --- toolchain ---------------------------------------------------------------

# Keep builds outside any local Go module and ignore inherited build flags.
build_go_binary() { ( cd "$1" && GOBIN="$2" GOFLAGS='' go install "$3" ); }

# The previous build is already in the pre-update snapshot.
install_go_binary() {
  local name="$1" pkg="$2"

  # A throwaway working directory keeps the build out of any local Go module.
  local workdir
  workdir="$(mktemp -d)" || return 1
  build_go_binary "$workdir" "$BIN_DIR" "$pkg"
  local status=$?
  rm -rf "$workdir"
  [ $status -eq 0 ] || return $status

  # Remove copies in earlier PATH directories that would shadow BIN_DIR.
  local gobin gopath dir
  gobin="$(go env GOBIN)"
  gopath="$(go env GOPATH)/bin"
  for dir in "$gobin" "$gopath"; do
    if [ -n "$dir" ] && [ "$dir" != "$BIN_DIR" ] && [ -f "$dir/$name" ]; then
      rm -f "$dir/$name"
    fi
  done
}

# Preserve the installed agent filter; do not invoke an unqualified sync when
# every installed agent was filtered out.
sync_gentle_ai_assets() {
  local runtime="$1" state="${GENTLE_AI_HOME:-$HOME/.gentle-ai}/state.json"
  local agent binary agents=() dropped=0

  while read -r agent; do
    [ -n "$agent" ] || continue
    case "$agent" in
      claude-code) binary=claude ;;
      *)           binary="$agent" ;;
    esac
    if [ "$agent" = pi ] && ! standalone_pi; then
      dropped=1
      skip 'gentle-ai sync for pi — not a separate Pi installation and home'
    elif command -v "$binary" >/dev/null 2>&1; then
      agents+=("$agent")
    else
      dropped=1
      skip "gentle-ai sync for $agent — '$binary' is not on PATH"
    fi
  done < <(jq -r '.installed_agents[]?' "$state" 2>/dev/null)

  if [ "$dropped" = 1 ]; then
    [ ${#agents[@]} -gt 0 ] || return 0
    "$runtime" sync --agents "$(IFS=,; printf '%s' "${agents[*]}")"
  else
    "$runtime" sync
  fi
}

# Read Go's embedded module metadata rather than guessing ownership from a
# filename, and reject worktree/dev builds (their module version is (devel)).
gentle_ai_build_version() {
  go version -m "$1" 2>/dev/null | awk -v module="$GENTLE_AI_MODULE" '
    $1 == "path" { main = $2 }
    $1 == "mod" { pkg = $2; version = $3 }
    END {
      if ((pkg == module "/v4" || pkg == module "/v5") && main == pkg "/cmd/gentle-ai" &&
          substr(version, 1, 2) == ("v" substr(pkg, length(pkg)))) print version
      else exit 1
    }'
}

install_gentle_ai() {
  local bin="$BIN_DIR/gentle-ai" workdir
  workdir="$(mktemp -d "$BIN_DIR/.gentle-ai-update.XXXXXX")" || return 1
  if build_go_binary "$workdir" "$workdir" "$GENTLE_AI_PKG" &&
      [ "$(gentle_ai_build_version "$workdir/gentle-ai")" = "$GENTLE_AI_VERSION" ] &&
      answers_version "$workdir/gentle-ai" && [ ! -L "$bin" ] &&
      mv -fT -- "$workdir/gentle-ai" "$bin"; then
    AI_READY=1
  fi
  rm -rf -- "$workdir"
  [ "$AI_READY" = 1 ]
}

in_shell_prefix() {
  local path prefix
  path="$(readlink -m -- "$1")" && prefix="$(readlink -m -- "$SHELL_PREFIX")" && [[ "$path/" == "$prefix/"* ]]
}

standalone_ai_version() {
  local bin="$BIN_DIR/gentle-ai" path version
  path="$(type -P gentle-ai || true)"
  [ ! -L "$bin" ] && { [ -z "$path" ] || [ "$path" = "$bin" ]; } || return 1
  [ -e "$bin" ] || return 0
  [ -f "$bin" ] && [ -x "$bin" ] && [ -O "$bin" ] || return 1
  version="$(gentle_ai_build_version "$bin")" && [[ "$version" =~ ^v$STABLE_VERSION$ ]] || return 1
  printf '%s\n' "$version"
}

update_gentle_ai() {
  local bin="$BIN_DIR/gentle-ai" version
  if held gentle-ai || ! command -v go >/dev/null 2>&1; then
    step gentle-ai 'gentle-ai (stable v5)' go install_gentle_ai
  elif in_shell_prefix "$BIN_DIR" || in_shell_prefix "${GENTLE_AI_HOME:-$HOME/.gentle-ai}" ||
      { [ -n "${GENTLE_AI_PI_CONFIG_DIR:-}" ] && in_shell_prefix "$GENTLE_AI_PI_CONFIG_DIR"; } ||
      { [ -n "${GENTLE_PI_CONFIG_HOME:-}" ] && in_shell_prefix "$GENTLE_PI_CONFIG_HOME"; }; then
    skip 'gentle-ai — bundled bin or state directory; use the Gentle Shell installation owner'
  elif ! version="$(standalone_ai_version)"; then
    skip 'gentle-ai — not a standalone installation in the update bin directory; use its installation owner'
  elif [ "$version" = "$GENTLE_AI_VERSION" ] && answers_version "$bin"; then
    AI_READY=1
  elif [[ "$version" == v5.* && "$version" != "$GENTLE_AI_VERSION" ]]; then
    skip "gentle-ai — installed $version is newer than the updater's $GENTLE_AI_VERSION pin"
  else
    step gentle-ai 'gentle-ai (stable v5)' go install_gentle_ai
  fi
}

shell_realpath() { readlink -e -- "$1"; }

# Identify the generated launcher independently of the active release's health.
# Parse its generated exec line as data, never source it to extract a path.
bundled_shell_prefix() {
  local prefix path launcher line embedded quoted="([^']|'\\\\'')*" escape="'\\''"
  local pattern="^exec '$quoted' '(/$quoted)/current/node_modules/gentle-pi/bin/gentle-shell\.mjs' \"\\\$@\"$"
  prefix="$(shell_realpath "$SHELL_PREFIX")" && path="$(type -P gentle-shell)" &&
    launcher="$(shell_realpath "$SHELL_LAUNCHER")" && [[ "$launcher" = "$prefix/bin/gentle-shell" ]] &&
    [ "$(shell_realpath "$path")" = "$launcher" ] || return 1
  [ -O "$prefix" ] && [ -O "$launcher" ] && [ -x "$launcher" ] || return 1
  grep -Fxq '# gentle-shell bundled launcher (generated; do not edit)' "$launcher" || return 1
  line="$(grep -Em1 '^exec ' "$launcher")" && [[ "$line" =~ $pattern ]] || return 1
  embedded="${BASH_REMATCH[2]//$escape/\'}"
  # The matched suffix is fixed. Resolve its prefix here so a broken current
  # does not turn an otherwise identifiable bundle into a legacy launcher.
  [ "$(shell_realpath "$embedded")" = "$prefix" ] || return 1
  printf '%s\n' "$prefix"
}

# An unattended upgrade also requires a completed active release and the exact
# pair reported by that launcher.
bundled_shell_version() {
  local prefix active id marker entry output
  local versions="^gentle-shell ($STABLE_VERSION)"$'\n'"pi ($STABLE_VERSION)\$"
  prefix="$(bundled_shell_prefix)" || return 1
  [ -L "$prefix/current" ] || return 1
  active="$(shell_realpath "$prefix/current")" || return 1
  id="${active##*/}"
  marker="$active/.gentle-shell-version"
  # Native Shell requires this relative pointer, even if an absolute link
  # could reach the same release. Keep the release inside its physical root.
  [ "$(readlink -- "$prefix/current")" = "versions/$id" ] && [ "${active%/*}" = "$prefix/versions" ] &&
    [ "$active" = "$(shell_realpath "$prefix/versions/$id")" ] &&
    [ -f "$marker" ] && [ ! -L "$marker" ] && [ -O "$marker" ] &&
    cmp -s "$marker" <(printf '%s\n' "$id") || return 1
  entry="$(shell_realpath "$active/node_modules/gentle-pi/bin/gentle-shell.mjs")" || return 1
  [[ "$entry" = "$active/"* ]] && [ -f "$entry" ] || return 1
  output="$(timeout 20 env -u GENTLE_SHELL_VERIFY_VERSION "$SHELL_LAUNCHER" --version 2>/dev/null </dev/null)" || return 1
  [[ "$output" =~ $versions ]] &&
    [ "$id" = "${BASH_REMATCH[1]}-${BASH_REMATCH[5]}" ] || return 1
  printf '%s\n' "${BASH_REMATCH[1]}"
}

# Record only an activation verified by this updater. A marker for a different
# active version never authorizes home changes, including after native rollback.
record_pending_shell_home() {
  local tmp
  tmp="$(mktemp "$SHELL_HOME_PENDING.XXXXXX")" || return 1
  if ! { printf '%s\n' "$1" > "$tmp" && mv -fT -- "$tmp" "$SHELL_HOME_PENDING"; }; then
    rm -f -- "$tmp"
    return 1
  fi
}

upgrade_gentle_shell() {
  local expected="$1" actual
  if ! run_pi_scoped "$SHELL_LAUNCHER" upgrade --channel release </dev/null; then
    warn "Gentle Shell launcher — native upgrade failed; $SHELL_MANUAL"
    return 1
  fi
  actual="$(bundled_shell_version)" || actual=unverified
  if [ "$actual" != "$expected" ]; then
    warn "Gentle Shell launcher — expected active $expected after upgrade, found $actual; $SHELL_MANUAL"
    return 1
  fi
  if ! record_pending_shell_home "$actual"; then
    warn 'Gentle Shell launcher — activated but could not record pending home setup; check the updater state directory and run Shell setup and extension refresh manually'
    return 1
  fi
  SHELL_HOME_VERSION="$actual"
}

update_gentle_shell() {
  local current latest
  if held gentle-shell; then
    skip 'Gentle Shell launcher — held by gentle-rollback (gentle-rollback unhold gentle-shell)'
  elif ! current="$(bundled_shell_version)"; then
    skip "Gentle Shell launcher — not a verified bundled PATH launcher; $SHELL_MANUAL"
  elif [[ "$current" != [45].* || "$current" == 4.0.* ]]; then
    skip "Gentle Shell launcher — unsupported launcher ($current); $SHELL_MANUAL"
  elif [[ "$current" == 5.* ]] && [ -f "$SHELL_HOME_PENDING" ] && [ ! -L "$SHELL_HOME_PENDING" ] &&
      cmp -s "$SHELL_HOME_PENDING" <(printf '%s\n' "$current"); then
    printf '  retrying unfinished Gentle Shell home setup (%s)\n' "$current"
    SHELL_HOME_VERSION="$current"
  # Match the upstream latestRelease source. This read cannot pin what the
  # native command resolves later, so independently verify the active result.
  elif ! latest="$(curl --disable --fail --silent --max-time 15 https://registry.npmjs.org/gentle-pi/latest |
      jq -er 'select(.name == "gentle-pi") | .version' 2>/dev/null)" || [[ ! "$latest" =~ ^$STABLE_VERSION$ ]]; then
    skip "Gentle Shell launcher — could not verify the official latest stable release; $SHELL_MANUAL"
  elif [[ "$latest" != 5.* ]]; then
    skip "Gentle Shell launcher — official latest stable is $latest, not v5; $SHELL_MANUAL"
  elif [ "$current" = "$latest" ]; then
    skip "Gentle Shell launcher — already current ($current)"
  elif [ "$(printf '%s\n' "$current" "$latest" | sort -V | tail -1)" = "$current" ]; then
    skip "Gentle Shell launcher — $current is newer than official latest $latest; $SHELL_MANUAL"
  else
    step gentle-shell 'Gentle Shell launcher (stable v5)' gentle-shell upgrade_gentle_shell "$latest"
  fi
}

# Pi and Gentle Shell spawn npm --prefix <home>/npm for project-scoped
# installs. npm 12 rejects allow-scripts arriving through npm_config_* env.
# A root project package.json#allowScripts takes priority over .npmrc: apply
# the *narrowly scoped* approvals there without touching explicit denials.
# Back up package.json before the first change. Clean up only the exact
# .npmrc entry introduced by our previous updater/preflight version.
configure_pi_npm_policy() {
  local dir="$1/npm" file="$1/npm/package.json" rc="$1/npm/.npmrc" tmp

  mkdir -p "$dir" || return 1
  if [ ! -f "$file" ]; then
    # A Pi home may not yet be initialized. Do not fabricate package.json:
    # Pi/Gentle Shell are responsible for creating their project metadata.
    warn "npm project not initialized yet: $dir (skipping script approvals)"
    return 0
  fi
  if [ -L "$file" ]; then
    warn "refusing symlinked npm package metadata: $file"
    return 1
  fi
  if ! jq -e 'type == "object" and ((.allowScripts == null) or (.allowScripts | type == "object"))' "$file" >/dev/null 2>&1; then
    warn "invalid package.json or allowScripts policy: $file"
    return 1
  fi

  # Existing false entries, including version-specific denials, remain as-is.
  # If a package was explicitly denied by name, do not override that denial.
  if ! jq -e --arg allow "$NPM_SCRIPT_ALLOWLIST" '
      (.allowScripts // {}) as $a
      | all(($allow | split(","))[]; $a[.] != null)
    ' "$file" >/dev/null 2>&1; then
    tmp="$(mktemp "${file}.tmp.XXXXXX")" || return 1
    chmod 600 "$tmp" || { rm -f "$tmp"; return 1; }
    if ! jq --arg allow "$NPM_SCRIPT_ALLOWLIST" '
      .allowScripts = ((.allowScripts // {}) as $a
        | reduce ($allow | split(",")[]) as $pkg ($a;
            if has($pkg) then . else . + {($pkg): true} end))
    ' "$file" > "$tmp"; then
      rm -f "$tmp"
      return 1
    fi
    if [ ! -e "$file.gentle-update.bak" ]; then
      cp -p -- "$file" "$file.gentle-update.bak" || { rm -f "$tmp"; return 1; }
    fi
    mv -f -- "$tmp" "$file" || { rm -f "$tmp"; return 1; }
    ok "npm package allowScripts policy: $file"
  fi

  # The former version wrote this single .npmrc setting. It is now ignored
  # because package.json defines allowScripts; remove only our exact line.
  if [ -f "$rc" ] && [ ! -L "$rc" ] && grep -Fqx "allow-scripts=$NPM_SCRIPT_ALLOWLIST" "$rc"; then
    tmp="$(mktemp "${rc}.tmp.XXXXXX")" || return 1
    chmod 600 "$tmp" || { rm -f "$tmp"; return 1; }
    if ! awk -v target="allow-scripts=$NPM_SCRIPT_ALLOWLIST" '$0 != target' "$rc" > "$tmp"; then
      rm -f "$tmp"
      return 1
    fi
    if [ ! -e "$rc.gentle-update.bak" ]; then
      cp -p -- "$rc" "$rc.gentle-update.bak" || { rm -f "$tmp"; return 1; }
    fi
    mv -f -- "$tmp" "$rc" || { rm -f "$tmp"; return 1; }
    ok "removed obsolete project .npmrc allow-scripts entry: $rc"
  fi
}

# Sanitize inherited env policy for CLI commands that invoke project npm.
# Their package.json owns the whitelist; never export it into npm_config_*.
run_pi_scoped() {
  env -u npm_config_allow_scripts -u NPM_CONFIG_ALLOW_SCRIPTS "$@"
}

# --- agents ------------------------------------------------------------------

# herdr manages the terminal this script usually runs in and refuses to replace
# its own binary from inside one of its sessions. Detect that rather than
# reporting it as a breakage.
update_herdr() {
  if ! command -v herdr >/dev/null 2>&1; then
    skip "herdr — not installed"
    return 0
  fi
  if [ -n "${HERDR_ENV:-}" ] && ! held herdr; then
    skip "herdr — run 'herdr update' from a terminal outside herdr"
    return 0
  fi
  step herdr "herdr" herdr herdr update
}

# The Herdr side of Gentle Shell: a Herdr plugin plus the Pi extension that
# feeds it. Both are installed when missing and updated otherwise; the sidebar
# configuration is re-applied afterwards because `configure` is idempotent
# ("append or repair") and a plugin update can replace what it manages.
HERDR_GS_PLUGIN="herdr-gentle-shell"
HERDR_GS_PLUGIN_SOURCE="jonasotoaguilar/herdr-gentle-shell/herdr-plugin"
HERDR_GS_EXTENSION="npm:herdr-gentle-shell"

sync_herdr_plugin() {
  local status=0
  if ! herdr plugin list 2>/dev/null | grep -q "$HERDR_GS_PLUGIN"; then
    herdr plugin install --yes "$HERDR_GS_PLUGIN_SOURCE" || return 1
  fi
  # No name: every GitHub-installed Herdr plugin is refreshed, not only ours.
  # A failing plugin is reported but must not stop the sidebar configuration.
  herdr plugin update --yes || status=1
  herdr plugin action invoke configure --plugin "$HERDR_GS_PLUGIN" || status=1
  return "$status"
}

sync_herdr_extension() {
  if "$SHELL_LAUNCHER" --isolated list 2>/dev/null | grep -qF "$HERDR_GS_EXTENSION"; then
    # Already declared: `update --extensions` above refreshed it.
    return 0
  fi
  if verify_shell_home_target; then
    run_pi_scoped "$SHELL_LAUNCHER" --isolated install "$HERDR_GS_EXTENSION"
  fi
}

# Herdr's per-agent integrations (the hook or extension it drops into each
# agent) are versioned and `herdr update` does not refresh them. Only the ones
# it reports as outdated are reinstalled: an update must never wire Herdr into
# an agent the user did not set up.
sync_herdr_integrations() {
  local agent status=0
  while read -r agent; do
    [ -n "$agent" ] || continue
    printf '  refreshing the herdr %s integration\n' "$agent"
    herdr integration install "$agent" || status=1
  done < <(herdr integration status 2>/dev/null | awk -F: '/: outdated/ { print $1 }')
  return "$status"
}

update_herdr_gentle_shell() {
  command -v herdr >/dev/null 2>&1 || return 0
  step herdr-integrations "Herdr agent integrations" herdr sync_herdr_integrations
  step herdr-plugin "Herdr plugins ($HERDR_GS_PLUGIN + sidebar)" herdr sync_herdr_plugin
  if verify_shell_home_target; then
    step gentle-shell "Gentle Shell extension $HERDR_GS_EXTENSION" gentle-shell sync_herdr_extension
  fi
}

# Codex only has marketplace upgrades in recent builds; an older one is skipped
# rather than reported as a breakage.
update_codex_plugins() {
  if ! codex plugin marketplace upgrade --help >/dev/null 2>&1; then
    printf '  this Codex has no plugin marketplace upgrade; skipped\n'
    return 0
  fi
  codex plugin marketplace upgrade
}

# --- plugins -----------------------------------------------------------------

update_claude_plugins() {
  claude plugin marketplace update || return 1

  local listing plugin status=0 managed=0
  # A failed list must not masquerade as an empty set of plugins.
  listing="$(claude plugin list)" || return 1
  while IFS= read -r plugin; do
    [ -n "$plugin" ] || continue
    case "$plugin" in
      *@inline)
        printf '  skipping %s (session-local --plugin-dir, no marketplace)\n' "$plugin"
        continue
        ;;
    esac
    managed=$((managed + 1))
    printf '  updating %s\n' "$plugin"
    claude plugin update "$plugin" || status=1
  done < <(printf '%s\n' "$listing" | rg -o '[A-Za-z0-9_-]+@[A-Za-z0-9_-]+' | sort -u)
  [ "$managed" -gt 0 ] || printf '  no marketplace-managed plugins found\n'
  return "$status"
}

# --- packages ----------------------------------------------------------------

# npm links bin names in install order, and corepack declares `pnpm` and `pnpx`
# just like pnpm does. After a global update corepack can end up owning those
# names, which silently swaps the installed pnpm for whatever version corepack
# resolves. Give them back to the package that is actually installed.
restore_pnpm_bins() {
  local npm_bin pkg name
  npm_bin="$(dirname "$(command -v npm)")" || return 0
  pkg="$npm_bin/../lib/node_modules/pnpm"
  [ -d "$pkg" ] || return 0

  for name in pnpm pnpx; do
    if [ -e "$pkg/$name" ] && readlink "$npm_bin/$name" 2>/dev/null | rg -q corepack; then
      ln -sf "../lib/node_modules/pnpm/$name" "$npm_bin/$name"
      ok "restored '$name' to the installed pnpm (corepack had claimed it)"
    fi
  done
}

# Same mapping as gentle-rollback: these packages are components of their own,
# every other npm global belongs to `npm-globals`.
npm_component() {
  case "$1" in
    "$PI_NPM_PACKAGE")           echo pi ;;
    "$GENTLE_SHELL_NPM_PACKAGE") echo gentle-shell ;;
    "$CODEX_NPM_PACKAGE")        echo codex ;;
    *)                           echo npm-globals ;;
  esac
}

# A blanket `npm update -g` would also bump packages whose component is held,
# so the packages are named one by one and the held ones are left out.
#
# Never change a global Gentle Shell launcher: only its owner may do that.
update_npm_globals() {
  local listing names pkg root dir identity component pkgs=()
  local package_name='^(@[A-Za-z0-9_][A-Za-z0-9._-]*/)?[A-Za-z0-9_][A-Za-z0-9._-]*$'
  # A listing that does not parse is not an empty listing: fail the step
  # instead of reporting that there was nothing to update. npm's own error
  # output is left on stderr.
  #
  # The exit status alone is not the test: `npm ls` also exits non-zero for an
  # extraneous or unmet-peer package while still printing a complete listing,
  # and that must not fail the step every single day.
  listing="$(npm ls -g --depth=0 --json)" || warn "npm ls -g exited non-zero; using its listing if it parses"
  # jq alone would accept empty output as "no packages", so require an object
  # that is not npm's error report.
  if [ -z "$listing" ] || ! names="$(jq -r 'if type == "object" and (has("error") | not)
      then (.dependencies // {} | keys[])
      else error("not a package listing") end' <<<"$listing" 2>/dev/null)"; then
    warn "npm ls -g printed no usable package list; npm globals were not updated"
    return 1
  fi

  if [ -n "$names" ]; then
    if ! root="$(npm root -g)" || [[ "$root" != /* ]] || ! root="$(readlink -e -- "$root")" || [ ! -d "$root" ]; then
      warn 'could not determine npm global package root; npm globals were not updated'
      return 1
    fi
  fi

  while read -r pkg; do
    [ -n "$pkg" ] || continue
    component="$(npm_component "$pkg")"
    if [ "$component" != gentle-shell ]; then
      # npm lists aliases by their install directory name, not their manifest
      # name. Read only a manifest inside the global root; leave links alone.
      dir="$root/$pkg"
      if [[ ! "$pkg" =~ $package_name ]] || [ "$(readlink -e -- "$dir")" != "$dir" ] ||
          [ ! -f "$dir/package.json" ] || [ -L "$dir/package.json" ] ||
          ! identity="$(jq -er '.name | strings' "$dir/package.json" 2>/dev/null)" || [[ ! "$identity" =~ $package_name ]]; then
        printf '  leaving %s alone (could not verify installed package identity)\n' "$pkg"
        continue
      fi
      if [ "$identity" = "$GENTLE_SHELL_NPM_PACKAGE" ]; then component="$(npm_component "$identity")"; fi
    fi
    if [ "$component" = gentle-shell ]; then
      printf '  leaving %s alone (managed by its installation owner)\n' "$pkg"
      continue
    fi
    if held "$component"; then
      printf '  leaving %s alone (held)\n' "$pkg"
      continue
    fi
    pkgs+=("$pkg")
  done <<<"$names"

  if [ ${#pkgs[@]} -eq 0 ]; then
    printf '  no npm globals to update\n'
    return 0
  fi
  npm update -g --allow-scripts="$NPM_SCRIPT_ALLOWLIST" "${pkgs[@]}" || return 1
  restore_pnpm_bins
}

# pnpm's global bin directory is not on this machine's PATH, which makes pnpm
# refuse every global command. Supply it for the duration of the call only.
#
# No `--latest`: that ignores the version range a package was installed with
# and jumps major versions, which is not something to do unattended.
update_pnpm_globals() {
  if [ ! -d "$PNPM_GLOBAL_HOME" ]; then
    skip "pnpm globals — no global store at $PNPM_GLOBAL_HOME"
    return 0
  fi
  # Resolve pnpm before touching PATH: the global bin directory holds a stale
  # pnpm shim that would otherwise win the lookup and fail to exec.
  local pnpm_bin listing names pkg packages=()
  pnpm_bin="$(command -v pnpm)" || return 1
  local -x PNPM_HOME="$PNPM_GLOBAL_HOME" PATH="$PNPM_GLOBAL_HOME/bin:$PATH"
  # Always pass explicit names, even if the listing did not contain gentle-pi.
  if ! listing="$("$pnpm_bin" ls -g --depth=0 --json)" ||
      ! names="$(jq -rs --arg shell "$GENTLE_SHELL_NPM_PACKAGE" '
        if length != 1 or (.[0] | type) != "array" then error("not a package listing") else .[0] end
        | [ .[] | (.dependencies // {}) | to_entries[] ] | group_by(.key)[]
        | if any(.[]; .key == $shell or .value.from == $shell or .value.name == $shell)
          then "!" else .[0].key end' <<<"$listing" 2>/dev/null)"; then
    warn 'pnpm printed no usable global package list; pnpm globals were not updated'
    return 1
  fi
  while read -r pkg; do
    case "$pkg" in
      '') ;;
      '!') printf '  leaving gentle-pi alone (managed by its installation owner)\n' ;;
      *) packages+=("$pkg") ;;
    esac
  done <<<"$names"
  if [ "${#packages[@]}" -gt 0 ]; then "$pnpm_bin" update -g "${packages[@]}"; fi
}

# Names of the features `moshi-hook doctor --json` reports as ok, one per line.
moshi_ok_features() {
  jq -r '.features[]? | select(.status == "ok") | .id' <<<"$1" 2>/dev/null | sort
}

# Updating the moshi-hook binary is only half of the job: the hooks written
# into each agent belong to the build that wrote them, and the daemon keeps
# running the old binary until it restarts.
#
# doctor is only ever run with --json. With --yes it applies its fixes without
# asking, which would install hooks and change host settings nobody chose.
update_moshi_hook() {
  local bin before_sha after_sha before_doc after_doc ready agent home regressed status=0
  local restarted=0 waited=0 ready_secs="${GENTLE_UPDATE_MOSHI_READY_SECS:-30}"
  [[ "$ready_secs" =~ ^[0-9]+$ ]] || ready_secs=30
  bin="$(command -v moshi-hook)" || return 1
  before_sha="$(sha256sum "$bin" | cut -d' ' -f1)"
  before_doc="$(moshi-hook doctor --json 2>/dev/null </dev/null)"
  note "moshi-hook doctor before: $before_doc"
  # Claude Code, Codex and Pi are always wired. Any other agent gets its hooks
  # reinstalled only when it already has them; an update must never wire Moshi
  # into an agent the user did not set up.
  ready="$(jq -r '.features[]? | select(.id == "inbox") | .readyAgents[]?' <<<"$before_doc" 2>/dev/null)"
  ready="$(printf '%s\n' "${MOSHI_AGENTS[@]}" "$ready" | awk 'NF && !seen[$0]++')"

  moshi-hook update || return 1

  while read -r agent; do
    case "$agent" in
      "") ;;
      pi)
        # doctor only reports the standard Pi home. Refresh the isolated
        # home as well only when this run selected and upgraded its Shell.
        home="${PI_HOMES[0]}"
        if standalone_pi_home && [ -d "$home" ]; then
          PI_CODING_AGENT_DIR="$home" moshi-hook install --target pi || status=1
        fi
        if [ -d "${PI_HOMES[1]}" ] && verify_shell_home_target; then
          PI_CODING_AGENT_DIR="${PI_HOMES[1]}" moshi-hook install --target pi || status=1
        fi
        ;;
      *)
        if ! command -v "$agent" >/dev/null 2>&1; then
          printf "  moshi-hook: %s is not installed; its hooks are left alone\n" "$agent"
          continue
        fi
        moshi-hook install --target "$agent" || status=1
        ;;
    esac
  done <<<"$ready"

  # Restarting drops the live connection to the phone, so only do it when
  # there is a new binary to load.
  after_sha="$(sha256sum "$bin" | cut -d' ' -f1)"
  if [ "$before_sha" != "$after_sha" ]; then
    moshi-hook service restart || status=1
    restarted=1
  else
    printf '  moshi-hook binary unchanged; daemon left running\n'
  fi

  # A daemon that was just restarted reports most features as down until it
  # has reconnected, which takes about a second. Ask again for a while before
  # calling that a regression; without a restart the first answer stands.
  while :; do
    after_doc="$(moshi-hook doctor --json 2>/dev/null </dev/null)"
    regressed="$(comm -23 <(moshi_ok_features "$before_doc") <(moshi_ok_features "$after_doc") | paste -sd, -)"
    [ -n "$regressed" ] && [ "$restarted" = 1 ] && [ "$waited" -lt "$ready_secs" ] || break
    sleep 1
    waited=$((waited + 1))
  done
  note "moshi-hook doctor after (waited ${waited}s): $after_doc"
  if [ -n "$regressed" ]; then
    warn "moshi-hook doctor: no longer ok after the update: $regressed"
    status=1
  fi
  return $status
}

# --- runtimes ----------------------------------------------------------------

update_runtimes() {
  warn "mise installs each runtime in its own directory; npm globals do not"
  warn "carry across Node versions. Reinstall your global CLIs afterwards."
  mise upgrade --yes
}

# --- health ------------------------------------------------------------------

# Gentle Shell ships under two sources (npm:gentle-pi and the gentle-shell git
# repo). A Pi home that declares both, or the same package twice, fails to load
# every duplicated tool. Report it; never edit a Pi settings.json silently.
check_pi_homes() {
  command -v jq >/dev/null 2>&1 || return 0
  local home file dupes
  for home in "${PI_HOMES[@]}"; do
    file="$home/settings.json"
    [ -f "$file" ] || continue
    dupes="$(jq -r '
      [.packages[]? | if type == "object" then .source else . end
        | sub("^npm:gentle-pi(@.*)?$"; "gentle-shell")
        | sub("^git:.*/gentle-shell(@.*)?$"; "gentle-shell")
        | sub("^(?<n>npm:@?[^@]+)@.*$"; "\(.n)")]
      | group_by(.) | map(select(length > 1) | .[0]) | join(", ")' "$file" 2>/dev/null)"
    if [ -n "$dupes" ]; then
      FAILED+=("Pi home $home declares duplicate packages: $dupes (edit $file)")
      warn "Pi home $home declares duplicate packages: $dupes"
    fi
  done
}

# `gentle-shell --isolated setup` re-adds an unpinned companion package (for
# example npm:gentle-engram) next to the pinned one it also writes, and Pi then
# fails to load the duplicated tool. Drop the bare entry only when a pinned entry
# for the same package exists in the Gentle Shell home, and say so out loud.
dedupe_gentle_shell_home() {
  command -v jq >/dev/null 2>&1 || return 0
  local file="${PI_HOMES[1]}/settings.json"
  [ -f "$file" ] || return 0

  local before after tmp
  before="$(jq -c '.packages // []' "$file" 2>/dev/null)" || return 0
  tmp="$(mktemp)" || return 0
  jq '.packages as $p
      | .packages = [ $p[]? | select(
          (type != "string") or (test("^npm:[^@]+$") | not)
          or ((. + "@") as $bare | any($p[]?; type == "string" and startswith($bare)) | not)
        ) ]' "$file" > "$tmp" 2>/dev/null || { rm -f "$tmp"; return 0; }
  after="$(jq -c '.packages // []' "$tmp")"

  if [ "$before" != "$after" ]; then
    cat "$tmp" > "$file"
    ok "removed duplicate unpinned package(s) from the Gentle Shell home: $before -> $after"
  fi
  rm -f "$tmp"
}

# Pi reads MCP servers from <home>/mcp.json, and `gentle-ai` only writes the
# standard home, so the Gentle Shell home never sees codegraph or any server
# installed later. Carry over the servers it is missing; an entry already in the
# Gentle Shell home is never touched, so local edits win.
sync_gentle_shell_mcp() {
  command -v jq >/dev/null 2>&1 || return 0
  local source="${PI_HOMES[0]}/mcp.json" target="${PI_HOMES[1]}/mcp.json"
  [ "$source" != "$target" ] && [ -f "$source" ] && [ -d "${PI_HOMES[1]}" ] || return 0

  local src dst='{}' merged added
  src="$(jq -c . "$source" 2>/dev/null)" || return 0
  if [ -f "$target" ]; then
    dst="$(jq -c . "$target" 2>/dev/null)" || {
      warn "Gentle Shell MCP config $target is not valid JSON; left untouched"
      return 0
    }
  fi

  added="$(jq -rn --argjson s "$src" --argjson d "$dst" \
    '(($s.mcpServers // {}) | keys) - (($d.mcpServers // {}) | keys) | join(", ")' 2>/dev/null)" || return 0
  [ -n "$added" ] || return 0
  merged="$(jq -n --argjson s "$src" --argjson d "$dst" \
    '$d | .mcpServers = (($s.mcpServers // {}) + ($d.mcpServers // {}))' 2>/dev/null)" || return 0

  [ -f "$target" ] || { : > "$target"; chmod 600 "$target"; }
  printf '%s\n' "$merged" > "$target"
  ok "added MCP server(s) to the Gentle Shell home: $added"
}

answers_version() { timeout 20 "$1" --version >/dev/null 2>&1 </dev/null; }

# Log-only: what a tool that stopped answering says now, and which copy it is.
note_version_failure() {
  [ -n "$LOG_FILE" ] || return 0
  local out status
  out="$(timeout 20 "$1" --version 2>&1 </dev/null)"
  status=$?
  note "$1 --version: exit $status ($(command -v "$1" 2>/dev/null || echo 'not on PATH')): ${out:0:2000}"
}

# Hold a component that could not be put back, so the next daily run does not
# reinstall the same broken release (possibly through the broken tool itself).
hold_broken() {
  "$ROLLBACK" hold "$1" "$2" 9>&- >/dev/null \
    || warn "$1 could not be held; the next run will try to update it again"
}

# A tool that answered `--version` before the run and no longer does was broken
# by this run. Put it back from the pre-update snapshot; gentle-rollback holds
# it, so tomorrow's run does not install the same broken release again.
#
# Each outcome is reported for what it is. "Rolled back" is only claimed when
# gentle-rollback restored something (exit 0, not 3 = nothing differed) and
# the tool answers again afterwards.
smoke_check() {
  local tool status
  for tool in "${WORKED_BEFORE[@]}"; do
    answers_version "$tool" && continue
    warn "$tool no longer runs after the update"
    note_version_failure "$tool"

    if [ "$tool" = gentle-shell ] && [ "$BUNDLED_SHELL_BEFORE" = 1 ]; then
      # Snapshot restore is the legacy npm path, not a native release switch.
      if [ -n "$ROLLBACK" ] && ! held gentle-shell; then
        hold_broken gentle-shell 'stopped working after an update; needs native recovery'
      fi
      FAILED+=("$tool broke after the update; use native 'gentle-shell upgrade --rollback' if available; otherwise $SHELL_MANUAL")
      continue
    fi

    if [ -z "$SNAPSHOT_ID" ]; then
      FAILED+=("$tool broke after the update; not rolled back (no snapshot)")
      continue
    fi

    # The snapshot is named by id: after the first restore `latest` would be
    # that restore's own pre-rollback snapshot, which holds the broken state.
    "$ROLLBACK" restore "$SNAPSHOT_ID" --only "$tool" --yes 9>&-
    status=$?
    hash -r 2>/dev/null || true

    if [ "$status" -eq 3 ]; then
      hold_broken "$tool" "stopped working after an update; recorded state unchanged"
      FAILED+=("$tool stopped working but its recorded state is unchanged; held, needs manual attention")
    elif [ "$status" -eq 0 ] && answers_version "$tool"; then
      FAILED+=("$tool broke after the update; rolled back and held")
    else
      # Includes mise and claude, whose restore runs the broken tool.
      hold_broken "$tool" "broke after an update; rollback to $SNAPSHOT_ID failed"
      FAILED+=("$tool broke after the update; rollback failed")
    fi
  done
}

# --- main --------------------------------------------------------------------

case "$TARGET" in
  all|agents|toolchain|plugins|packages|runtimes) ;;
  -h|--help)
    # The header comment is the manual; print it without the comment markers.
    sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  *)
    printf 'usage: gentle-update [all|agents|toolchain|plugins|packages|runtimes]\n' >&2
    exit 2
    ;;
esac

# Everything this installs belongs to the user. As root it would leave
# root-owned files in the user's tool directories and update root's own copies.
if [ "${EUID:-$(id -u)}" -eq 0 ]; then
  printf 'gentle-update: refusing to run as root; run it as your own user\n' >&2
  exit 1
fi

# Without these the lock, the snapshot, or a step would fail in a way that
# reads as "busy" or "nothing to do", so check them before doing anything.
for tool in jq flock sha256sum timeout rg; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    printf 'gentle-update: missing required tool: %s; nothing was updated\n' "$tool" >&2
    exit 1
  fi
done

wants() { [ "$TARGET" = all ] || [ "$TARGET" = "$1" ]; }
# The native launcher resolves current on each invocation. A rollback outside
# our lock can invalidate the earlier selection; stop all further home work
# and leave its pending marker in place as soon as we observe a mismatch.
verify_shell_home_target() {
  local actual message
  [ -n "$SHELL_HOME_VERSION" ] && ! held gentle-shell || return 1
  actual="$(bundled_shell_version)" || actual=unverified
  if [ "$actual" != "$SHELL_HOME_VERSION" ]; then
    message="Gentle Shell home — expected active $SHELL_HOME_VERSION, found $actual; $SHELL_MANUAL"
    FAILED+=("$message")
    warn "$message"
    SHELL_HOME_VERSION=''
    return 1
  fi
}
standalone_pi_home() {
  local home
  home="$(readlink -m -- "${PI_HOMES[0]}")" || return 1
  ! in_shell_prefix "$home" && [ "$home" != "$(readlink -m -- "${PI_HOMES[1]}")" ]
}
standalone_pi() {
  local path
  path="$(type -P pi || true)"
  standalone_pi_home && { [ -z "$path" ] || ! in_shell_prefix "$path"; }
}

apply_pi_npm_policy() {
  if ! configure_pi_npm_policy "$1"; then
    FAILED+=("npm project policy: $1")
    warn "failed to configure npm install-script policy for $1"
  fi
}

# Started before the lock is taken, so the log writers never inherit it.
start_log "$@"

mkdir -p "$BIN_DIR"

# Under systemd (or any shell that mise did not activate) node, npm, pnpm, go
# and every npm-installed CLI are missing from PATH. Ask mise for the
# environment an interactive shell would have. It is resolved from $HOME so a
# project-local mise config never decides which runtimes get updated.
if [ -z "${MISE_SHELL:-}" ]; then
  MISE_BIN="$BIN_DIR/mise"
  [ -x "$MISE_BIN" ] || MISE_BIN="$(command -v mise 2>/dev/null || true)"
  if [ -n "$MISE_BIN" ]; then
    cd "$HOME" || exit 1
    # mise's own error output is left on stderr. A failure here must stop the
    # run: carrying on would skip every step as "not installed" and still
    # report success.
    if ! MISE_ENV="$("$MISE_BIN" env -s bash)" || [ -z "$MISE_ENV" ]; then
      printf 'gentle-update: "%s env -s bash" failed or printed no environment; nothing was updated\n' "$MISE_BIN" >&2
      exit 1
    fi
    eval "$MISE_ENV"
  fi
fi
# Locally installed tools win over the copies mise may also provide.
PATH="$BIN_DIR:$PATH"
export PATH

# Run every step from $HOME, so a project-local .pi directory or package
# manifest in the directory this was started from never takes part.
cd "$HOME" || exit 1

note_environment
# Only from here on: the environment mise printed above may carry secrets, and
# a trace would write every one of them to disk.
start_trace
# A user shell may have inherited npm's one-off install policy. Project npm
# commands must not inherit it; global npm commands use explicit CLI flags.
unset npm_config_allow_scripts NPM_CONFIG_ALLOW_SCRIPTS

# One lock for gentle-update and gentle-rollback, held on descriptor 9 until
# this process exits. A run that finds it taken has nothing to do: the other
# run is already updating (or restoring) the same tools.
mkdir -p "$STATE" && chmod 700 "$STATE" || exit 1
exec 9>"$STATE/lock" || exit 1
if ! flock -n 9; then
  printf 'gentle-update: another update or rollback is already running; nothing to do.\n'
  exit 0
fi
# Tells the gentle-rollback calls below not to take the lock again.
export GENTLE_UPDATE_LOCK_HELD=1

# gentle-rollback normally sits next to this script; $0 may be a symlink.
ROLLBACK="$(dirname "$(readlink -f "$0")")/gentle-rollback"
[ -x "$ROLLBACK" ] || ROLLBACK="$(command -v gentle-rollback 2>/dev/null || true)"

if bundled_shell_prefix >/dev/null; then BUNDLED_SHELL_BEFORE=1; fi
for tool in "${SMOKE_TOOLS[@]}"; do
  if answers_version "$tool"; then WORKED_BEFORE+=("$tool"); fi
done

bold "Before"
report_versions

# No update without a way back. The snapshot is what `gentle-rollback restore`
# and the smoke check at the end restore from.
if [ "${GENTLE_UPDATE_NO_SNAPSHOT:-}" = 1 ]; then
  warn "GENTLE_UPDATE_NO_SNAPSHOT=1 — updating without a snapshot; this run cannot be rolled back"
elif [ -z "$ROLLBACK" ]; then
  warn "gentle-rollback not found next to this script or on PATH; nothing was updated"
  warn "(set GENTLE_UPDATE_NO_SNAPSHOT=1 to update without a snapshot)"
  exit 1
elif SNAPSHOT_ID="$("$ROLLBACK" snapshot --reason "pre-update ($TARGET)" 9>&-)" && [ -n "$SNAPSHOT_ID" ]; then
  if wants agents || wants toolchain; then
    ok "snapshot $SNAPSHOT_ID (undo supported components with: gentle-rollback restore $SNAPSHOT_ID)"
  else
    ok "snapshot $SNAPSHOT_ID (undo with: gentle-rollback restore $SNAPSHOT_ID)"
  fi
else
  warn "the pre-update snapshot failed; nothing was updated"
  warn "(set GENTLE_UPDATE_NO_SNAPSHOT=1 to update without a snapshot)"
  exit 1
fi

if wants agents || wants toolchain; then
  heading "Pi / Gentle Shell npm project policy"
  if ! held pi && standalone_pi_home; then apply_pi_npm_policy "${PI_HOMES[0]}"; fi
fi

if wants agents || wants toolchain; then
  heading "Gentle Shell standalone launcher"
  update_gentle_shell
fi

if wants agents; then
  if ! standalone_pi; then
    skip 'PATH Pi runtime + extensions — not a separate Pi installation and home'
  else
    # --all refreshes the plain Pi runtime and packages, but not its catalog.
    step pi "PATH Pi runtime + extensions" pi run_pi_scoped pi update --all
    step pi "Pi model catalog" pi pi update --models
  fi
fi
if verify_shell_home_target; then
  heading "Gentle Shell isolated home"
  shell_home_failures=${#FAILED[@]}
  shell_home_skips=${#SKIPPED[@]}
  apply_pi_npm_policy "${PI_HOMES[1]}"
  if verify_shell_home_target; then
    step gentle-shell "Gentle Shell setup" gentle-shell run_pi_scoped "$SHELL_LAUNCHER" --isolated setup
    if verify_shell_home_target; then
      step gentle-shell "Gentle Shell extensions" gentle-shell run_pi_scoped "$SHELL_LAUNCHER" --isolated update --extensions
      if verify_shell_home_target; then
        step gentle-shell "Gentle Shell model catalog" gentle-shell "$SHELL_LAUNCHER" --isolated update --models
        if [ "$shell_home_failures" -eq "${#FAILED[@]}" ] && [ "$shell_home_skips" -eq "${#SKIPPED[@]}" ]; then
          SHELL_HOME_READY=1
        fi
      fi
    fi
  fi
fi

if wants agents; then
  heading "AI agents (latest stable)"
  step claude   "Claude Code" claude   claude update
  step codex    "Codex"       codex    codex update
  step codex-plugins "Codex plugin marketplaces" codex update_codex_plugins
  update_herdr
  update_herdr_gentle_shell
fi

if wants toolchain; then
  heading "Gentleman toolchain (latest release)"
  update_gentle_ai
  step engram "engram" go install_go_binary engram "$ENGRAM_PKG"
  if [ "$AI_READY" = 1 ]; then
    step gentle-ai "gentle-ai sync" gentle-ai sync_gentle_ai_assets "$BIN_DIR/gentle-ai"
  fi
fi

if wants plugins; then
  heading "Claude Code plugins"
  step claude-plugins "Claude Code plugins" claude update_claude_plugins
fi

if wants packages; then
  heading "Global packages"
  step npm-globals  "npm globals"  npm        update_npm_globals
  step pnpm-globals "pnpm globals" pnpm       update_pnpm_globals
  step moshi-hook   "moshi-hook"   moshi-hook update_moshi_hook
  step mise         "mise"         mise       mise self-update --yes
fi

# Opt-in only: never reached by `all`.
if [ "$TARGET" = runtimes ]; then
  heading "Language runtimes (mise)"
  step runtimes "mise runtimes" mise update_runtimes
fi

hash -r 2>/dev/null || true

if verify_shell_home_target; then dedupe_gentle_shell_home; fi
if verify_shell_home_target; then sync_gentle_shell_mcp; fi
if [ "$SHELL_HOME_READY" = 1 ] && verify_shell_home_target && ! rm -f -- "$SHELL_HOME_PENDING"; then
  FAILED+=("could not clear pending Gentle Shell home setup for $SHELL_HOME_VERSION")
  warn "could not clear pending Gentle Shell home setup for $SHELL_HOME_VERSION"
fi
check_pi_homes
smoke_check

bold "After"
report_versions

if [ ${#SKIPPED[@]} -gt 0 ]; then
  bold "Skipped"
  printf '  • %s\n' "${SKIPPED[@]}"
fi

if [ -s "$WARN_FILE" ]; then
  bold "Warnings"
  awk '!seen[$0]++ { print "  • " $0 }' "$WARN_FILE"
fi
[ -n "$WARN_FILE" ] && rm -f "$WARN_FILE"

if [ ${#FAILED[@]} -gt 0 ]; then
  bold "Errors"
  printf '  • %s\n' "${FAILED[@]}"
  printf '\nRestart your agents once the failures above are resolved.\n'
  exit 1
fi

bold "Done — restart Claude Code, Gentle Shell, and any open agent to load the new builds."
